concern-augok-name = Aegis-Arsenal
concern-augok-description = Aetherion Dynamics, Ullman Industries and the Colossus Civil Defense Militia combine ship gunnery, Dravon autocannons and defensive systems.

concern-drake-black-arms-usa-name = Aquila Ink.
concern-drake-black-arms-usa-description = A.Q.U.I.L.A. stands for Advanced Quartermaster Unified Industrial Logistics Agency. Drake Industries, Blackhawk, Midnight Arms and the Universal States of America supply weapons, security services, ship protection and industrial mining equipment.

concern-horizon-harmony-hammer-matter-name = Synthesis Holding
concern-horizon-harmony-hammer-matter-description = Horizon Energy, Harmony Medical, Steel Hammer and Dark Matter Enterprises combine gas extraction, medicine, shipbuilding, repairs and material processing.

concern-buno-name = CORPUS
concern-buno-description = Paycheck Bratva, the Hive and Nosske-Eien combine protective biotechnology, life insurance and specialized equipment.

concern-tech-disk-augok-name = Aegis-Arsenal technology disk
concern-tech-disk-augok-description = Unlocks Aetherion gunnery control, the Dravon and CDM shields.
concern-tech-disk-drake-black-arms-usa-name = Aquila Ink. technology disk
concern-tech-disk-drake-black-arms-usa-description = Unlocks weapons, ship protection, industrial mining equipment and armored gas pipes from the concern's members.
concern-tech-disk-horizon-harmony-hammer-matter-name = Synthesis Holding technology disk
concern-tech-disk-horizon-harmony-hammer-matter-description = Unlocks gas extraction, medical equipment, repair drones and material processing.
concern-tech-disk-buno-name = CORPUS technology disk
concern-tech-disk-buno-description = Unlocks protective organs, life insurance and specialized equipment.

concern-tech-disk-case-description = A sealed case containing a concern's technology disk and an encryption key for its private network.

