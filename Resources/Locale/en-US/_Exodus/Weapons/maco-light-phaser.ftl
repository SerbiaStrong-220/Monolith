ent-WeaponLightPhaserMaco = MACo light phaser
    .desc = A bulky handheld phaser manufactured by Midnight Arms Co. Holds two disposable plutonium cartridges. Requires both hands to fire a broad pulse capable of severing a limb. Can be carried on the back.

ent-WeaponLightPhaserMacoEmpty = { ent-WeaponLightPhaserMaco }
    .desc = { ent-WeaponLightPhaserMaco.desc }
    .suffix = Empty

ent-CartridgeLightPhaserMaco = MACo light phaser cartridge
    .desc = A disposable plutonium cartridge for one shot from a Midnight Arms Co. light phaser. The weapon holds two cartridges. This is not a rechargeable battery.

ent-BulletLightPhaserMaco = phaser pulse
    .desc = A fast, broad energy pulse fired by a phaser.
