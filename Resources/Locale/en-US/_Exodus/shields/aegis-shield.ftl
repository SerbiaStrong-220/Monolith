aegis-shield-generator-name = Hex shield generator
aegis-shield-generator-description = A 3x3 ship shield generator that projects a teal honeycomb field. It protects ship equipment from EMPs while active. After 9 seconds without impacts, its self-repairing honeycomb increases active field regeneration by 40%.
aegis-shield-board-name = Hex shield generator board
aegis-shield-board-description = A machine board for a Hex shield generator. Requires a centered 3x3 machine frame.

ent-ShieldGeneratorAegis = { aegis-shield-generator-name }
    .desc = { aegis-shield-generator-description }
ent-ShieldGeneratorAegisMachineCircuitboard = { aegis-shield-board-name }
    .desc = { aegis-shield-board-description }
