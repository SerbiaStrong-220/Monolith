# alert-level-violet-instructions = Crewmembers are advised to distance themselves from others and perform safety measures to prevent further spread.
alert-level-violet-announcement = Biological weapons are active in the sector. Chimera activity has been reported.
alert-level-violet-instructions = Chimeras are active. An unknown ship that does not answer is treated as compromised.
alert-level-violet-start = Attention all contractors! Transition to violet code has begun. Biological weapons have been detected in the Colossus sector.
alert-level-violet-end = Transition complete. Violet code is in effect. Enable identification beacons. Any unknown ship that does not make contact will be treated as chimera-controlled and destroyed.

# alert-level-yellow = Yellow
alert-level-yellow = Pink
