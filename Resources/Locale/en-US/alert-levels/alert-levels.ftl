# Monolith: added Monolith-specific alert text

# alert-level-green = Green
# Exodus: sector codes renamed from the existing alert levels.
alert-level-green = Green
# alert-level-green-announcement = It is now safe to return to your workplaces.
# alert-level-green-instructions = Do your job.
alert-level-green-announcement = The sector is operating normally. No significant threat to civilians has been recorded.
alert-level-green-instructions = Normal operations. No significant threat to civilians.
alert-level-green-start = Attention all contractors! Transition to green code has begun. The sector is stabilizing.
alert-level-green-end = Transition complete. Green code is in effect. All services return to normal operations.

# alert-level-blue = Blue
alert-level-blue = Blue
# alert-level-blue-announcement = There is a confirmed threat to TSF rogue space. Security should perform random checks. Crewmembers are advised to be vigilant and report suspicious activity.
# alert-level-blue-instructions = Crewmembers are advised to be vigilant and report suspicious activity.
alert-level-blue-announcement = Pirate activity in the sector is rising. Civilian ships should avoid travelling alone.
alert-level-blue-instructions = Rising pirate activity. An unknown ship that does not answer is treated as hostile.
alert-level-blue-start = Attention all contractors! Transition to blue code has begun. Pirate activity has been recorded in the Colossus sector.
alert-level-blue-end = Transition complete. Blue code is in effect. Enable identification beacons. Any unknown ship that does not make contact will be treated as piratical and destroyed.

# alert-level-red = Red
alert-level-red = Red
# alert-level-red-announcement = There is an immediate threat to the station. Security should prepare to use lethal force if necessary. Crewmembers should find a safe place to shelter in, and are advised to follow any present authorities.
# alert-level-red-instructions = Crewmembers should find a safe place to shelter in, and are advised to follow any present authorities.
# Exodus-begin: emergency warning without claiming authority over independent factions.
alert-level-red-announcement = A threat to the survival of the sector has been detected. Crews are advised to seek shelter and factions to coordinate their defenses.
alert-level-red-instructions = Critical sector-wide threat. Civilian shelter and a coordinated defense are recommended.
alert-level-red-start = Attention! This is not a drill! A sector-wide threat has been detected. Emergency transition to red code has begun. Faction commands and independent crews are advised to temporarily suspend hostilities and coordinate measures to protect the sector.
alert-level-red-end = Red code is in effect. A critical sector-wide threat remains. Civilian crews are advised to seek shelter in safe locations and monitor announcements. Forces willing to assist in the defense are advised to coordinate with the defenders of Colossus station.
# Exodus-end

# alert-level-violet = Violet
alert-level-violet = Violet
