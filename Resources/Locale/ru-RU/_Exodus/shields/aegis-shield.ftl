aegis-shield-generator-name = генератор щита «Гекс»
aegis-shield-generator-description = Корабельный генератор щита размером 3x3, создающий бирюзовое поле с сотовым узором. Защищает оборудование корабля от ЭМИ, пока поле активно. После 9 секунд без попаданий самовосстановление сот ускоряет регенерацию активного поля на 40%.
aegis-shield-board-name = плата генератора щита «Гекс»
aegis-shield-board-description = Печатная плата для генератора щита «Гекс». Требуется центрированный машинный каркас размером 3x3.

ent-ShieldGeneratorAegis = { aegis-shield-generator-name }
    .desc = { aegis-shield-generator-description }
ent-ShieldGeneratorAegisMachineCircuitboard = { aegis-shield-board-name }
    .desc = { aegis-shield-board-description }
