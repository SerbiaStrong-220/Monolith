exodus-hardpoint-examine = Класс платформы: [color=yellow]{ $class }[/color]. Размер: [color=yellow]{ $size }[/color]. Совместимое оружие этого размера или меньше стреляет без штрафа. Более крупное оружие стреляет медленнее.
exodus-hardpoint-weapon-examine = Требования к платформе: [color=yellow]{ $class }[/color], размер [color=yellow]{ $size }[/color]. Темп стрельбы с учётом текущей установки: [color=yellow]{ $percent }%[/color]. Это влияет на выстрелы и паузы между очередями, но не на заряжание и восстановление энергии.
exodus-hardpoint-class =
    { $class ->
        [Ballistic] баллистика
        [Energy] энергетика
        [Missile] ракеты
        [Universal] универсальный
       *[other] неизвестный
    }
exodus-hardpoint-size =
    { $size ->
        [Superlight] сверхлёгкий
        [Light] лёгкий
        [Medium] средний
        [Heavy] тяжёлый
        [Superheavy] сверхтяжёлый
       *[other] неизвестный
    }

ent-BaseHardpoint = орудийное крепление
    .desc = Стационарная платформа для корабельного оружия. Совместимые орудия подходящего размера сохраняют штатную скорострельность.

ent-HardpointDebugSuperlight = сверхлёгкое универсальное орудийное крепление
    .desc = Отладочная платформа для сверхлёгких орудий любого класса. Более крупные орудия стреляют со штрафом.
    .suffix = Отладка, НЕ МАППИТЬ

