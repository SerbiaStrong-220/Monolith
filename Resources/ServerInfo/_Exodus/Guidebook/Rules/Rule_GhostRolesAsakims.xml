      <Box Orientation="Vertical" HorizontalAlignment="Stretch" Margin="8">
        [color=#DDCFDF]Азакимы - искусственно выведенные суперсолдаты Империи Кхси'Ра эпохи до Раскола. Они генетически родственны унатхам, но созданы для войны, захвата территории и удержания стратегических точек.[/color]
      </Box>

      <Box Orientation="Vertical" HorizontalAlignment="Stretch" Margin="6">
        [font="DefaultBold" size=17][color=#E2B9EB]Разделы[/color][/font]
      </Box>

      <ColorBox Color="#1B1424" OutlineColor="#67416F" OutlineThickness="1">
        <Box HorizontalAlignment="Stretch" Margin="6">
          <GuideEntityEmbed Entity="MobAsakimGhostrole" Caption="" Scale="1.75" Interactive="false"/>
          <Box Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="6">
            [color=#DDCFDF]1. [textlink="Воин Азаким" link="EXRuleGhostRoleAsakim"][/color]
          </Box>
        </Box>
      </ColorBox>

      <ColorBox Color="#1B1424" OutlineColor="#67416F" OutlineThickness="1">
