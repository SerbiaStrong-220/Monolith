light_mode unshaded;

// Displacement in texture coordinates, angular speed in radians per second, and phase offset.
uniform highp float strength;
uniform highp float speed;
uniform highp float phase;

void fragment()
{
    highp float time = TIME * speed + phase;
    highp vec2 position = UV * 6.2831853;

    // Broad currents carry smaller eddies through the original cloud texture.
    highp vec2 flow = vec2(
        sin(position.y * 2.0 + time),
        sin(position.x * 3.0 - time * 0.8));
    highp vec2 eddies = vec2(
        sin(position.y * 5.0 - time * 1.3 + flow.y),
        sin(position.x * 4.0 + time * 1.1 + flow.x));

    // Keep tile boundaries fixed: the source textures do not use repeat sampling.
    highp vec2 edge = smoothstep(vec2(0.0), vec2(0.08), UV)
        * (vec2(1.0) - smoothstep(vec2(0.92), vec2(1.0), UV));
    highp vec2 offset = (flow * 0.75 + eddies * 0.25) * strength * edge.x * edge.y;
    highp vec2 halfPixel = TEXTURE_PIXEL_SIZE * 0.5;
    highp vec2 sampleUV = clamp(UV + offset, halfPixel, vec2(1.0) - halfPixel);

    COLOR = zTexture(sampleUV);
}
