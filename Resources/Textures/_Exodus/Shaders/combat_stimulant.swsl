uniform sampler2D SCREEN_TEXTURE;
uniform highp float Strength;
uniform highp float Pulse;

void fragment()
{
    highp vec4 scene = zTextureSpec(SCREEN_TEXTURE, Pos);
    highp float edge = smoothstep(0.35, 1.15, length(Pos * 2.0 - 1.0));
    highp float strength = clamp(Strength, 0.0, 1.0);
    // Multiplication keeps darkness and the FOV mask black; no neighbouring pixels are sampled.
    highp vec3 tint = mix(vec3(1.0), vec3(0.85, 1.0, 0.92), strength);
    highp float vignette = 1.0 - 0.18 * edge * Pulse * strength;
    COLOR = vec4(scene.rgb * tint * vignette, scene.a);
}
