uniform sampler2D SCREEN_TEXTURE;
uniform sampler2D LIGHT_TEXTURE;
uniform highp float Strength;
uniform highp float LightThreshold;
uniform highp float LightSaturation;

const highp vec3 Luminance = vec3(0.2126, 0.7152, 0.0722);

void fragment()
{
    highp vec4 scene = zTextureSpec(SCREEN_TEXTURE, Pos);
    highp vec3 light = texture2D(LIGHT_TEXTURE, Pos).rgb;
    highp float illumination = dot(light, Luminance);
    highp float exposure = smoothstep(LightThreshold, LightSaturation, illumination);

    // Light alone must never reveal a black FOV mask or brighten unlit pixels.
    // Gate by the already rendered image as well, without sampling neighbouring pixels.
    highp float visible = smoothstep(0.08, 0.35, dot(scene.rgb, Luminance));
    highp float washout = clamp(Strength, 0.0, 1.0) * exposure * visible;
    COLOR = vec4(mix(scene.rgb, vec3(1.0), washout), scene.a);
}
