<!-- Exodus: per-item line on sell pallet appraisal -->
<PanelContainer xmlns="https://spacestation14.io"
                Access="Public"
                StyleClasses="PanelBackgroundLight"
                Margin="0 1 0 1"
                HorizontalExpand="True"
                SetHeight="36">
    <BoxContainer Orientation="Horizontal"
                  HorizontalExpand="True"
                  SeparationOverride="6"
                  Margin="4 0 4 0">
        <TextureRect Name="Icon"
                     Access="Public"
                     MinSize="28 28"
                     MaxSize="28 28"
                     Stretch="KeepAspectCentered"
                     HorizontalExpand="False" />
        <Label Name="ItemName"
               Access="Public"
               HorizontalExpand="True"
               ClipText="True"
               VerticalAlignment="Center" />
        <Label Name="Quantity"
               Access="Public"
               MinWidth="48"
               Align="Right"
               VerticalAlignment="Center"
               StyleClasses="LabelSubText" />
        <Label Name="UnitPrice"
               Access="Public"
               MinWidth="72"
               Align="Right"
               VerticalAlignment="Center"
               StyleClasses="LabelSubText" />
        <Label Name="TotalPrice"
               Access="Public"
               MinWidth="80"
               Align="Right"
               VerticalAlignment="Center" />
    </BoxContainer>
</PanelContainer>
