<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'ui-conveyor-speed-label'}"
               MinSize="240 90">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6" Margin="8">
        <Button Name="Tier1" Text="{Loc 'ui-conveyor-speed-low'}"    HorizontalExpand="True" StyleClasses="OpenRight"/>
        <Button Name="Tier2" Text="{Loc 'ui-conveyor-speed-medium'}" HorizontalExpand="True" StyleClasses="OpenBoth"/>
        <Button Name="Tier3" Text="{Loc 'ui-conveyor-speed-high'}"   HorizontalExpand="True" StyleClasses="OpenLeft"/>
    </BoxContainer>
</DefaultWindow>
