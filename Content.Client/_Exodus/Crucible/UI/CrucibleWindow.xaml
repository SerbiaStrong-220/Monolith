<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client._Exodus.Crucible.UI.CrucibleWindow"
               Title="{Loc 'crucible-window-title'}"
               MinWidth="250">
    <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="10">

        <Label Name="StatusLabel"
               Text="{Loc 'crucible-window-status-waiting'}"
               HorizontalAlignment="Center"/>

        <Label Name="ItemLabel"
               Text="{Loc 'crucible-window-item-none'}"
               HorizontalAlignment="Center"/>

        <Label Name="TimerLabel"
               HorizontalAlignment="Center"
               Visible="False"/>

        <ProgressBar Name="CookingProgress"
                     MinValue="0"
                     MaxValue="1"
                     Value="0"
                     MinHeight="20"/>

        <Button Name="StartButton"
                Text="{Loc 'crucible-window-start-button'}"
                Disabled="True"/>

    </BoxContainer>
</DefaultWindow>
